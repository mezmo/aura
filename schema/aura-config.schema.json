                  "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "transport",
            "cmd"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "description": {
              "default": null,
              "type": "string"
            },
            "headers": {
              "additionalProperties": {
                "type": "string"
              },
              "default": {},
              "type": "object"
            },
            "headers_from_request": {
              "additionalProperties": {
                "type": "string"
              },
              "default": {},
