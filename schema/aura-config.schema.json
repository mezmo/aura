              "type": "object"
            },
            "transport": {
              "anyOf": [
                {
                  "const": "http_streamable",
                  "type": "string"
                },
                {
                  "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "transport",
            "url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "description": {
              "default": null,
              "type": "string"
            },
            "headers": {
              "additionalProperties": {
                "type": "string"
              },
              "default": {},
              "type": "object"
            },
            "headers_from_request": {
              "additionalProperties": {
                "type": "string"
              },
              "default": {},
              "type": "object"
            },
            "scratchpad": {
              "additionalProperties": {
                "$ref": "#/$defs/ScratchpadToolEntry"
              },
              "default": {},
              "description": "Per-tool scratchpad interception thresholds (glob-matched on tool name).",
              "type": "object"
            },
            "transport": {
              "anyOf": [
                {
                  "const": "sse",
                  "type": "string"
                },
                {
                  "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
                  "type": "string"
                }
              ]
