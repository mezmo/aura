{
  "$defs": {
    "AgentConfig": {
      "additionalProperties": false,
      "description": "Agent configuration (TOML `[agent]` table shape).\n\nThis is the TOML-facing view of the agent config. The runtime\n`AgentRuntimeConfig` in the `aura` crate extracts a subset (`AgentSettings`)\nfor agent construction.",
      "properties": {
        "alias": {
          "default": null,
          "type": "string"
        },
        "client_tool_filter": {
          "default": null,
          "description": "Glob patterns selecting which client-side tools this agent can call.\n`None` or empty means all client tools are available when\n`enable_client_tools = true`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "context": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "created_at": {
          "description": "Creation timestamp in milliseconds since epoch (defaults to current time)",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "enable_client_tools": {
          "default": false,
          "description": "Whether this agent (single-agent or orchestration coordinator) may\ninvoke client-side tools advertised on the request. When false\n(default), client tools are not attached even if the request\nsupplied them.",
          "type": "boolean"
        },
        "hidden": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "anyOf": [
                {
                  "enum": [
                    "true",
                    "false"
                  ],
                  "type": "string"
                },
                {
                  "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
                  "type": "string"
                }
              ]
            }
          ],
          "default": false,
          "description": "Indicates an agent should be hidden from a models list endpoint.\nUseful when a model is not ready to be  or should only be invoked\nby known callers (default: false)"
        },
        "llm": {
          "$ref": "#/$defs/LlmConfig",
          "default": {
            "additional_params": null,
            "api_key": "",
            "base_url": null,
            "context_window": null,
            "max_tokens": null,
            "model": "gpt-4o",
            "provider": "openai",
            "reasoning_effort": null,
            "temperature": null
          },
          "description": "LLM configuration for this agent.\n\nParsed from the `[agent.llm]` TOML table. Workers inherit this config\nwhen no `[orchestration.worker.<name>.llm]` is provided."
        },
        "mcp_filter": {
          "default": null,
          "description": "Glob patterns for filtering which MCP tools to include.\nWhen set, only tools matching at least one pattern are added.\nExample: `mcp_filter = [\"sin\", \"cos\", \"degreesToRadians\"]`",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "model_owner": {
          "default": null,
          "description": "Override the `owned_by` field in /v1/models responses.\nWhen omitted, defaults to the underlying LLM provider (e.g. \"openai\", \"anthropic\").",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "nudge_last_turn": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "anyOf": [
                {
                  "enum": [
                    "true",
                    "false"
                  ],
                  "type": "string"
                },
                {
                  "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
                  "type": "string"
                }
              ]
            }
          ],
          "default": false,
          "description": "Nudge the agent on its final turn to submit its results instead of\ncalling more tools (default: false)."
        },
        "nudge_turns_remaining": {
          "default": null,
          "description": "Nudge the agent to start wrapping up when this many turns remain\nbefore the turn-depth limit. `None` disables wrap-up nudging.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "scratchpad": {
          "$ref": "#/$defs/ScratchpadConfig",
          "default": null,
          "description": "Agent-level scratchpad config. Workers inherit this unless they\nprovide `[orchestration.worker.<name>.scratchpad]`."
        },
        "skills": {
          "$ref": "#/$defs/SkillsConfig",
          "default": {
            "local": []
          },
          "description": "Skill discovery sources. Workers inherit these unless they provide\n`[orchestration.worker.<name>.skills]`."
        },
        "system_prompt": {
          "type": "string"
        },
        "turn_depth": {
          "default": 5,
          "description": "Maximum depth of tool calls per turn (default: 5, set to 0 to disable)",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "system_prompt"
      ],
      "type": "object"
    },
    "ArtifactsConfig": {
      "additionalProperties": false,
      "description": "Artifact and persistence configuration for orchestration.\n\n# Example\n\n```toml\n[orchestration.artifacts]\nmemory_dir = \"/tmp/aura-orchestration\"\nresult_artifact_threshold = 4000\nresult_summary_length = 2000\n```",
      "properties": {
        "max_session_runs": {
          "default": 20,
          "description": "Maximum number of run directories retained per session. When a new run\nis created and the directory count exceeds this limit, the oldest runs\nare pruned. Set to 0 to disable pruning. Default: 20.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "memory_dir": {
          "default": null,
          "description": "Optional base directory for execution persistence and plan storage.\n\nStructure: `<memory_dir>/<run_id>/iteration-{n}/...`\nIf not set, execution persistence is disabled.",
          "type": "string"
        },
        "memory_path": {
          "default": null,
          "description": "Optional base directory for execution persistence and plan storage.\n\nStructure: `<memory_dir>/<run_id>/iteration-{n}/...`\nIf not set, execution persistence is disabled.",
          "type": "string"
        },
        "persistence_drain_timeout_ms": {
          "default": 2000,
          "description": "Timeout (ms) for draining in-flight persistence writes between execute()\nand write_plan(). Default: 2000ms.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "result_artifact_threshold": {
          "default": 4000,
          "description": "Character threshold for writing large results to artifact files.\nResults exceeding this length are written to disk with an inline summary.\nDefault: 4000 characters.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "result_summary_length": {
          "default": 2000,
          "description": "Maximum length of inline summary when a result is written to an artifact.\nDefault: 2000 characters.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "session_history_turns": {
          "default": 3,
          "description": "Maximum number of prior run manifests auto-injected into the coordinator\npreamble as session context. Set to 0 to disable session history injection.\nDefault: 3.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "show_tool_reasoning_in_continuation": {
          "default": false,
          "description": "When true, include condensed tool reasoning traces in the continuation\nprompt so the coordinator can see why workers called specific tools.\nDefault: false.",
          "type": "boolean"
        },
        "tool_output_artifact_threshold": {
          "default": 500,
          "description": "Character threshold for promoting tool outputs to artifact files.\nOutputs exceeding this size get written to artifacts/ with an inline\nfooter referencing the file. Set to 0 to promote all tool outputs.\nDefault: 500.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "tool_output_duration_threshold_ms": {
          "default": 5000,
          "description": "Duration threshold (ms) for promoting tool outputs to artifact files.\nTool calls exceeding this duration get promoted regardless of size.\nSet to 0 to disable duration-based promotion. Default: 5000ms.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "DecisionRouteConfig": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "Attended: the approver is already at the client (default timeout 60s).",
          "properties": {
            "mode": {
              "anyOf": [
                {
                  "const": "conversational",
                  "type": "string"
                },
                {
                  "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
                  "type": "string"
                }
              ]
            },
            "timeout_secs": {
              "default": 60,
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Unattended: the webhook may page a human or route through chat ops\n(default timeout 300s).",
          "properties": {
            "headers": {
              "additionalProperties": {
                "type": "string"
              },
              "default": {},
              "description": "Static webhook headers.",
              "type": "object"
            },
            "headers_from_request": {
              "additionalProperties": {
                "type": "string"
              },
              "default": {},
              "description": "Outbound header name → inbound request header name mapping.",
              "type": "object"
            },
            "mode": {
              "anyOf": [
                {
                  "const": "webhook",
                  "type": "string"
                },
                {
                  "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
                  "type": "string"
                }
              ]
            },
            "timeout_secs": {
              "default": 300,
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "tool_headers_from_response": {
              "$ref": "#/$defs/ToolHeaderMappings",
              "description": "Outbound MCP header name → webhook approval-response header name.\nNon-empty opts gated calls into approver identity forwarding.\nValidated at parse (see [`ToolHeaderMappings`]); the validated\nmap is carried but not consumed until capture wiring lands."
            },
            "url": {
              "$ref": "#/$defs/WebhookUrl"
            }
          },
          "required": [
            "mode",
            "url"
          ],
          "type": "object"
        }
      ],
      "description": "`[hitl.route]` table. The `Webhook` variant cannot parse without a valid\nURL, so the \"url required, never empty\" invariant holds structurally."
    },
    "EmbeddingConfig": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "api_key": {
              "type": "string"
            },
            "base_url": {
              "default": null,
              "description": "Custom API endpoint for OpenAI-compatible embedding servers",
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "provider": {
              "anyOf": [
                {
                  "const": "openai",
                  "type": "string"
                },
                {
                  "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "provider",
            "api_key",
            "model"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string"
            },
            "profile": {
              "default": null,
              "description": "AWS profile name (optional, uses default credentials if not specified)",
              "type": "string"
            },
            "provider": {
              "anyOf": [
                {
                  "const": "bedrock",
                  "type": "string"
                },
                {
                  "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
                  "type": "string"
                }
              ]
            },
            "region": {
              "type": "string"
            }
          },
          "required": [
            "provider",
            "model",
            "region"
          ],
          "type": "object"
        }
      ],
      "description": "Embedding model configuration with strong typing per provider"
    },
    "GlobPattern": {
      "description": "A tool-name glob pattern.",
      "type": "string"
    },
    "HitlConfig": {
      "additionalProperties": false,
      "description": "`[hitl]` config table. `Option<HitlConfig>` on [`Config`] is the enable bit;\nthere is no `enabled` bool.",
      "properties": {
        "require_approval": {
          "default": [],
          "description": "Glob patterns whose match gates a tool call. Compiled at TOML load.",
          "items": {
            "$ref": "#/$defs/GlobPattern"
          },
          "type": "array"
        },
        "route": {
          "$ref": "#/$defs/DecisionRouteConfig",
          "description": "The decision route; required when `[hitl]` is present."
        }
      },
      "required": [
        "route"
      ],
      "type": "object"
    },
