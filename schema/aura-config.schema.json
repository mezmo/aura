      ],
      "description": "Individual MCP server configuration"
    },
    "OrchestrationConfig": {
      "additionalProperties": false,
      "description": "Configuration for orchestration mode (multi-agent coordinator/worker workflows).",
      "properties": {
        "allow_clarification": {
          "default": true,
          "type": "boolean"
        },
        "allow_direct_answers": {
          "default": true,
          "type": "boolean"
        },
        "artifacts": {
          "$ref": "#/$defs/ArtifactsConfig",
          "default": null
        },
        "coordinator_vector_stores": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "duplicate_call_block_threshold": {
          "default": 5,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "duplicate_call_nudge_threshold": {
          "default": 3,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "max_plan_parse_retries": {
          "default": 3,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_planning_cycles": {
          "default": 3,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_tools_per_worker": {
          "default": 10,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "memory_dir": {
          "default": null,
          "type": "string"
        },
        "memory_path": {
          "default": null,
          "type": "string"
        },
        "persistence_drain_timeout_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "result_artifact_threshold": {
          "default": null,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "result_summary_length": {
          "default": null,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "session_history_turns": {
          "default": null,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "timeouts": {
          "$ref": "#/$defs/TimeoutsConfig",
          "default": null
        },
        "tool_output_artifact_threshold": {
          "default": null,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "tool_output_duration_threshold_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tools_in_planning": {
          "$ref": "#/$defs/ToolVisibility",
          "default": "summary"
        },
        "worker": {
          "additionalProperties": {
            "$ref": "#/$defs/WorkerConfig"
          },
          "default": {},
          "type": "object"
        },
        "worker_system_prompt": {
          "default": null,
          "type": "string"
        }
      },
      "type": "object"
    },
    "ReasoningEffort": {
      "anyOf": [
        {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "type": "string"
        },
        {
          "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
          "type": "string"
        }
      ],
      "description": "Reasoning effort level for GPT-5 models"
    },
    "ScratchpadConfig": {
      "additionalProperties": false,
      "description": "Scratchpad configuration.\n\nConfigured at `[agent.scratchpad]` for the default (inherited by all workers),\nand optionally overridden at `[orchestration.worker.<name>.scratchpad]`.\nA worker's effective config is the agent defaults merged with any overrides\non the worker.",
      "properties": {
        "context_safety_margin": {
          "default": 0.20000000298023224,
          "description": "Fraction (0.0–1.0) of the context window reserved for reasoning + output.",
          "format": "float",
          "type": "number"
        },
        "enabled": {
          "default": false,
          "description": "Whether scratchpad is active for this agent/worker.",
          "type": "boolean"
        },
        "max_extraction_tokens": {
          "default": 10000,
          "description": "Maximum tokens a single extraction tool may return.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "turn_depth_bonus": {
          "default": 6,
          "description": "Extra turns added when scratchpad is active (to account for exploration).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ScratchpadToolEntry": {
      "additionalProperties": false,
      "description": "Per-tool scratchpad override, configured via `[mcp.servers.<name>.scratchpad]`.\n\nControls when a tool's output gets intercepted and diverted to scratchpad\nstorage instead of being returned inline to the LLM.",
      "properties": {
        "min_tokens": {
          "default": 5120,
          "description": "Minimum output size (in tokens) before interception kicks in.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "SkillsConfig": {
      "additionalProperties": false,
      "description": "The `[agent.skills]` TOML table: where to discover skills from.",
      "properties": {
        "local": {
          "default": [],
          "description": "Local skill sources (directories containing skill subdirectories)",
          "items": {
            "$ref": "#/$defs/LocalSkillSource"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "TimeoutsConfig": {
      "additionalProperties": false,
      "description": "Timeout configuration for orchestration LLM calls.\n\n# Example\n\n```toml\n[orchestration.timeouts]\nper_call_timeout_secs = 120\nstream_inactivity_timeout_secs = 45\n```",
      "properties": {
        "per_call_timeout_secs": {
          "default": 0,
          "description": "Wall-clock budget (seconds) for one coordinator phase or one worker\ntask. 0 disables.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stream_inactivity_timeout_secs": {
          "default": 0,
          "description": "Inactivity window (seconds) for coordinator and worker streams; governs\nsilence between stream items. 0 disables.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ToolHeaderMappings": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Outbound MCP header name → webhook approval-response header name.",
      "type": "object"
    },
    "ToolVisibility": {
      "anyOf": [
        {
          "anyOf": [
            {
              "const": "none",
              "type": "string"
            },
            {
              "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
              "type": "string"
            }
          ],
          "description": "No tool information in planning prompt (minimal context, display only)."
        },
        {
          "anyOf": [
            {
              "const": "summary",
              "type": "string"
            },
            {
              "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
              "type": "string"
            }
          ],
          "description": "Tool names only, bucketed by worker (default — good balance, display only)."
        },
        {
          "anyOf": [
            {
              "const": "full",
              "type": "string"
            },
            {
              "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
              "type": "string"
            }
          ],
          "description": "Tool names with descriptions (maximum context, higher token usage, display only)."
        }
      ],
      "description": "Controls how tool information is shown to the coordinator during planning.\n\nThis is **display only** — it does not affect which tools workers can execute.\nTool execution access is controlled by each worker's `mcp_filter`.\nThis setting only affects what the coordinator sees when deciding how to\nassign tasks, balancing context length vs. precision."
    },
    "ToolsConfig": {
      "additionalProperties": false,
      "description": "Tools configuration",
      "properties": {
        "custom_tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "filesystem": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "VectorStoreConfig": {
      "anyOf": [
        {
          "properties": {
            "embedding_model": {
              "$ref": "#/$defs/EmbeddingConfig"
            },
            "type": {
              "anyOf": [
                {
                  "const": "in_memory",
                  "type": "string"
                },
                {
                  "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "type",
            "embedding_model"
          ],
          "type": "object"
        },
        {
          "properties": {
            "collection_name": {
              "type": "string"
            },
            "embedding_model": {
              "$ref": "#/$defs/EmbeddingConfig"
            },
            "type": {
              "anyOf": [
                {
                  "const": "qdrant",
                  "type": "string"
                },
                {
                  "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "embedding_model",
            "url",
            "collection_name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "knowledge_base_id": {
              "type": "string"
            },
            "managed": {
              "default": false,
              "description": "Bedrock managed knowledge base (vs. classic vector-store-backed)",
              "type": "boolean"
            },
            "profile": {
              "default": null,
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "type": {
              "anyOf": [
                {
                  "const": "bedrock_kb",
                  "type": "string"
                },
                {
                  "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "type",
            "knowledge_base_id",
            "region"
          ],
          "type": "object"
        }
      ],
      "description": "Vector store configuration (in-memory, Qdrant, and Bedrock KB)",
      "properties": {
        "context_prefix": {
          "default": null,
          "description": "Optional context string describing what the vector store contains (for better LLM guidance)",
          "type": "string"
        },
        "name": {
          "description": "Unique name to identify this vector store",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "WebhookUrl": {
      "anyOf": [
        {
          "pattern": "^https?://",
          "type": "string"
        },
        {
          "pattern": "\\{\\{\\s*env\\.[A-Z_][A-Z0-9_]*(\\s*\\|\\s*default:\\s*'[^']*')?\\s*\\}\\}",
          "type": "string"
        }
      ],
      "description": "A webhook URL with an http(s) scheme."
    },
    "WorkerConfig": {
      "additionalProperties": false,
      "description": "Per-worker configuration for specialized workers.\n\nWorkers are specialized agents with custom preambles and filtered tool access.\nConfigure workers using TOML sections like `[orchestration.worker.operations]`.\n\n# Example\n\n```toml\n[orchestration.worker.operations]\ndescription = \"For logs, pipelines, metrics, and system analysis\"\npreamble = \"You are an Operations Specialist...\"\nmcp_filter = [\"mezmo_*\"]\n```",
      "properties": {
        "description": {
          "description": "Short description of this worker's purpose (for planning prompt).\n\nThis is shown to the LLM during planning so it can assign tasks appropriately.\nKeep it concise (one line).",
          "type": "string"
        },
        "llm": {
          "$ref": "#/$defs/LlmConfig",
          "default": null,
          "description": "Optional per-worker LLM override.\n\nWhen `Some`, the worker runs with this LLM config instead of inheriting\n`[agent.llm]`. The resolved `context_window` drives per-worker budget\nmath (e.g. scratchpad sizing)."
        },
        "mcp_filter": {
          "default": null,
          "description": "Glob patterns for which MCP tools this worker gets access to.\n\nExamples:\n- omitted - all tools (default)\n- `[\"mezmo_*\"]` - all tools starting with \"mezmo_\"\n- `[\"ListKnowledgeBases\", \"QueryKnowledgeBases\"]` - specific tools\n- `[]` - no MCP tools\n\nPatterns are matched using glob syntax (supports `*`, `**`, `?`, `[abc]`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "preamble": {
          "description": "System prompt for this worker (replaces generic worker preamble).\n\nThis is the complete system prompt - it does NOT use the worker_preamble.md template.\nFor specialized workers, provide domain-specific instructions here.",
          "type": "string"
        },
        "scratchpad": {
          "$ref": "#/$defs/ScratchpadConfig",
          "default": null,
          "description": "Per-worker override of `[agent.scratchpad]`. Parsed from\n`[orchestration.worker.<name>.scratchpad]`."
        },
        "skills": {
          "$ref": "#/$defs/SkillsConfig",
          "default": null,
          "description": "Per-worker skill sources. Parsed from `[orchestration.worker.<name>.skills]`.\n`None` inherits `[agent.skills]`; an explicit empty list disables skills\nfor this worker; a non-empty list replaces the agent's skills entirely\n(no merging)."
        },
        "turn_depth": {
          "default": null,
          "description": "Max tool-calling turns for this worker.\n\nControls how many Rig ReAct turns (tool calls) a worker can make\nper task execution. Overrides `[agent].turn_depth`. Falls back to\n`[agent].turn_depth` → `DEFAULT_MAX_DEPTH` if not set.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "vector_stores": {
          "default": [],
          "description": "Vector stores this worker has access to.\n\nBy default (empty), workers have NO vector store access. Workers must\nexplicitly list the stores they need. This prevents unintended RAG\naccess and keeps workers focused on their specialization.\n\nValues should match the `name` field of entries in `[[vector_stores]]`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "description",
        "preamble"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Root configuration structure for our POC",
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentConfig"
    },
    "hitl": {
      "$ref": "#/$defs/HitlConfig",
      "default": null,
      "description": "Human-in-the-loop approval gating. `None` (no `[hitl]` table) disables\nit; presence of the table is the enable bit."
    },
    "mcp": {
      "$ref": "#/$defs/McpConfig"
    },
    "memory_dir": {
      "default": null,
      "description": "Top-level persistence directory shared by scratchpad and orchestration\nartifacts. `[orchestration.artifacts].memory_dir` is honored as a\nlegacy fallback.",
      "type": "string"
    },
    "orchestration": {
      "$ref": "#/$defs/OrchestrationConfig",
      "default": null,
      "description": "Orchestration mode configuration (multi-agent workflows)"
    },
    "tools": {
      "$ref": "#/$defs/ToolsConfig"
    },
    "vector_stores": {
      "default": [],
      "description": "Vector stores for RAG - optional, defaults to empty",
      "items": {
        "$ref": "#/$defs/VectorStoreConfig"
      },
      "type": "array"
    }
  },
  "required": [
    "agent"
  ],
  "title": "AURA agent configuration",
  "type": "object"
}
