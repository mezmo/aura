          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_inference_duration_seconds_bucket{instance=~\"$instance\",aura_agent=~\"$config\",gen_ai_agent_name=~\"$agent\"}[$__rate_interval])))",
