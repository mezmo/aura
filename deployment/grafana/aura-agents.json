{
  "uid": "aura-agents",
  "title": "AURA agents",
  "description": "One section per agent name (main agents and workers alike), repeated from the Agent variable and narrowed by Config; the same instruments as AURA overview, read per agent instead of per agent-and-tool line. Opened from an agent series on the overview.",
  "tags": [
    "aura",
    "genai"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(target_info{service_name=\"aura\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(target_info{service_name=\"aura\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "config",
        "label": "Config",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(gen_ai_client_inference_duration_seconds_count{instance=~\"$instance\"}, aura_agent)",
          "refId": "config"
        },
        "definition": "label_values(gen_ai_client_inference_duration_seconds_count{instance=~\"$instance\"}, aura_agent)",
        "description": "The loaded agent config ([agent].name). With several selected, same-named workers of different configs share one section.",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "agent",
        "label": "Agent",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(gen_ai_client_inference_duration_seconds_count{instance=~\"$instance\",aura_agent=~\"$config\"}, gen_ai_agent_name)",
          "refId": "agent"
        },
        "definition": "label_values(gen_ai_client_inference_duration_seconds_count{instance=~\"$instance\",aura_agent=~\"$config\"}, gen_ai_agent_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "AURA overview",
      "type": "link",
      "url": "/d/aura-overview/aura-overview",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "$agent",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "repeat": "agent"
    },
    {
      "type": "stat",
      "title": "LLM calls",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(gen_ai_client_inference_duration_seconds_count{instance=~\"$instance\",aura_agent=~\"$config\",gen_ai_agent_name=~\"$agent\"}[$__range]))",
          "legendFormat": "calls",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
